# Copy to .env and edit. Never commit .env.
APP_ENV=development
APP_TIMEZONE=Africa/Lagos
# Folder the app is served from. XAMPP htdocs/eduverse -> /eduverse ; php -S dev server -> leave empty
APP_BASE_PATH=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eduverse
DB_USER=root
DB_PASS=

# First administrator, created by: php database/seed_admin.php
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# AI: auto = Hugging Face if HF_API_TOKEN is set, otherwise clearly-labelled MOCK mode
AI_MODE=auto
HF_API_TOKEN=
HF_MODEL=
HF_ENDPOINT=https://router.huggingface.co/v1/chat/completions
AI_RATE_LIMIT_PER_HOUR=20

JITSI_DOMAIN=meet.jit.si
MAX_UPLOAD_MB=20
PLAGIARISM_THRESHOLD=0.5
MAIL_MODE=log
